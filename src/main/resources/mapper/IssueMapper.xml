<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.yyy.sideproject.mapper.IssueMapper">

    <select id="findIssuesByCondition" resultType="com.yyy.sideproject.domain.Issue">
        SELECT * FROM ISSUES
        <where>
            <if test="title != null and title != ''">
                AND title LIKE '%' || #{title} || '%'
            </if>
            
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        ORDER BY id DESC
    </select>
    
</mapper>